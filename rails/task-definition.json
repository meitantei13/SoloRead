{
  "family": "solo-read-task-definition-backend",
  "containerDefinitions": [
    {
      "name": "rails",
      "image": "901005418622.dkr.ecr.ap-northeast-1.amazonaws.com/solo-read-rails:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "rails-3000-tcp",
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "RAILS_LOG_TO_STDOUT",
          "value": "true"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "value": "REMOVED"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://solo-read.click/"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://localhost:6379/0"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/solo-read-task-definition-backend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    },
    {
      "name": "nginx",
      "image": "901005418622.dkr.ecr.ap-northeast-1.amazonaws.com/solo-read-nginx@sha256:4ed3a9cfc81021546db1990536ff061517c9c576d23f3e7bb2dc07bf7cd0fae1",
      "cpu": 0,
      "memory": 512,
      "memoryReservation": 256,
      "portMappings": [
        {
          "name": "nginx-80-tcp",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [
        {
          "sourceContainer": "rails",
          "readOnly": false
